    {
      "id": "K_t2uIE24oYA_PNKUa-Q5",
      "type": "text",
      "x": 548.1666666666699,
      "y": 1300.2063492063494,
      "width": 1775.4215720847822,
      "height": 181.66666666666674,
      "angle": 0,
      "strokeColor": "#1e1e1e",
