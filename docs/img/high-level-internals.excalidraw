      "isDeleted": false,
      "boundElements": null,
      "updated": 1792493192142,
      "created": 1792492557029,
      "link": null,
      "locked": false,
      "text": "Contains:\n- Lua-scripts\n    - A single source of truth that gets manipulated\n    - Parameters are: KEY:string, PERIOD:int, LIMIT:int\n        - KEY = hash key (e.g. ratelimit:abc-123)\n        - PERIOD = period in seconds (e.g. 60)\n        - LIMIT = limit (max hits per period)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contains:\n- Lua-scripts\n    - A single source of truth that gets manipulated\n    - Parameters are: KEY:string, PERIOD:int, LIMIT:int\n        - KEY = hash key (e.g. ratelimit:abc-123)\n        - PERIOD = period in seconds (e.g. 60)\n        - LIMIT = limit (max hits per period)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
