      "link": null,
      "locked": false
    },
    {
      "id": "WjKhBG7LeYNNdlNt3gP9z",
      "type": "text",
      "x": 258.07539682539937,
      "y": 2898.880952380954,
      "width": 451.45001220703125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PYhgoa4SpVK08MIsHhDqp"
      ],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 2112462433,
      "version": 232,
      "versionNonce": 1043394273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794313976972,
      "created": 1794313906194,
      "link": null,
      "locked": false,
      "text": "GLOSSARY\n- Unit = Rate limiting unit\n- Shard = Redis shard",
      "fontSize": 36,
      "baseFontSize": null,
