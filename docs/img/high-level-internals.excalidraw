    {
      "id": "1HOnJlx9OLjFpLnWlxdFf",
      "type": "text",
      "x": 1355,
      "y": -142.5,
      "width": 261.1666564941406,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1869909977,
      "version": 110,
      "versionNonce": 1491889975,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792493764951,
      "created": 1792492516773,
      "link": null,
      "locked": false,
      "text": "Contains:\n- A REST API\n- A local cache (Ristretto)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contains:\n- A REST API\n- A local cache (Ristretto)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "UX8Oa60Pfrd9Nm8ilyMaA",
      "type": "text",
      "x": 1793,
      "y": -132.5,
      "width": 800,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 2005645113,
      "version": 1052,
      "versionNonce": 155087481,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792493753551,
      "created": 1792492557029,
      "link": null,
      "locked": false,
      "text": "Contains:\n- Lua-scripts\n    - A single source of truth that gets manipulated\n    - Parameters are: KEY:string, PERIOD:int, LIMIT:int\n        - KEY = hash key (e.g. ratelimit:abc-123)\n        - PERIOD = period in seconds (e.g. 60)\n        - LIMIT = limit (max hits per period)\n    - If no entry exists for this HASH, one will be created\n    - If a HASH exists, its existing data will be used\n        - I'm using //go:embed directive to embed the script directly, and then the \n            script is added to Redis via redis.NewScript -> EVALSHA\n            - This approach enables multiple versions of the same script, and all \n                sorts of different scripts (and versions) to coexist",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Contains:\n- Lua-scripts\n    - A single source of truth that gets manipulated\n    - Parameters are: KEY:string, PERIOD:int, LIMIT:int\n        - KEY = hash key (e.g. ratelimit:abc-123)\n        - PERIOD = period in seconds (e.g. 60)\n        - LIMIT = limit (max hits per period)\n    - If no entry exists for this HASH, one will be created\n    - If a HASH exists, its existing data will be used\n        - I'm using //go:embed directive to embed the script directly, and then the \n            script is added to Redis via redis.NewScript -> EVALSHA\n            - This approach enables multiple versions of the same script, and all \n                sorts of different scripts (and versions) to coexist",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
